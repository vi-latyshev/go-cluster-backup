{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "UTC",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "Default: a dependency outside the image releases nothing.",
      "semanticCommitType": "chore",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "The Go module is compiled into the binary, so its updates release a patch.",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "go.mod"
      ],
      "semanticCommitType": "fix",
      "groupName": "go modules"
    },
    {
      "description": "A base image update changes the shipped image, so it releases a patch.",
      "matchManagers": [
        "dockerfile"
      ],
      "semanticCommitType": "fix",
      "groupName": "container images"
    },
    {
      "description": "The copied PostgreSQL 15 client stays on 15: a 16 client cannot stand in a directory named 15, and the image build refuses a suite whose programs disagree with their own directory. It rides the alpine container-images group.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/library/postgres"
      ],
      "allowedVersions": "<16",
      "semanticCommitType": "fix",
      "groupName": "container images"
    },
    {
      "description": "The lint, vulnerability and chart tools never reach the binary.",
      "matchManagers": [
        "gomod"
      ],
      "matchFileNames": [
        "tools/**"
      ],
      "semanticCommitType": "chore",
      "groupName": "go tools"
    },
    {
      "description": "Pinned workflow actions are CI only.",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "chore",
      "groupName": "github actions"
    },
    {
      "description": "The Go toolchain moves as one: the go directive of both modules and the golang image.",
      "matchDatasources": [
        "golang-version",
        "docker"
      ],
      "matchPackageNames": [
        "go",
        "docker.io/library/golang"
      ],
      "groupName": "go toolchain",
      "rangeStrategy": "bump",
      "semanticCommitType": "fix"
    }
  ]
}
