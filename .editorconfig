# One style for every file in the repository. The tools that write files here
# (gofmt, helm-docs, an editor) and the tools that read them agree on it.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yaml,yml,json,md,gotmpl}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_style = space
indent_size = 2
